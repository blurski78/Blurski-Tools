(() => {
'use strict';
if (window.__hs) return;

const looks = v => typeof v === 'string' && /^[\w-]{20,}\.[\w-]{5,12}\.[\w-]{20,}$/.test(v);

function findToken() {
  try {
    const raw = localStorage.getItem('token');
    if (raw) { try { const p = JSON.parse(raw); if (looks(p)) return p; } catch (e) { if (looks(raw)) return raw; } }
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i), v = localStorage.getItem(k);
      if (!v) continue;
      let p; try { p = JSON.parse(v); } catch (e) { p = v; }
      if (looks(p)) return p;
    }
  } catch (e) {}

  try {
    const mods = [];
    webpackChunkdiscord_app.push([['__tk' + Date.now()], {}, e => { for (const k in e.c) mods.push(e.c[k]); }]);
    for (const m of mods) {
      const ex = m && m.exports;
      if (!ex) continue;
      for (const f of [
        ex.default && ex.default.getToken,
        ex.getToken,
        ex.default && ex.default.default && ex.default.default.getToken
      ]) {
        if (typeof f === 'function') {
          try { const t = f.call(ex.default || ex); if (looks(t)) return t; } catch (e) {}
        }
      }
    }
    for (const m of mods) {
      const ex = m && m.exports;
      if (!ex || typeof ex !== 'object') continue;
      for (const k in ex) {
        const v = ex[k];
        if (looks(v)) return v;
        if (v && typeof v === 'object') for (const k2 in v) if (looks(v[k2])) return v[k2];
      }
    }
  } catch (e) {}

  return '';
}

const SVG = p => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>" + p + "</svg>";

// All three houses use custom PNGs (embedded as data URIs so they load regardless of Discord's CSP)
const BRAVERY_PNG = 'data:image/png;base64,';
const BRILLIANCE_PNG = 'data:image/png;base64,';
const BALANCE_PNG = 'data:image/png;base64,';

const H = [
  { id: 1, n: 'Bravery',    c: '#676fd8', img: BRAVERY_PNG },
  { id: 2, n: 'Brilliance', c: '#f8724d', img: BRILLIANCE_PNG },
  { id: 3, n: 'Balance',    c: '#3bd1b4', img: BALANCE_PNG }
];

const hs = document.createElement('div');
hs.style.cssText = `
  position:fixed; z-index:2147483647; left:50%; bottom:22px; width:320px; padding:12px;
  border-radius:18px; background:#16181f; border:1px solid #2b2e38;
  box-shadow:0 16px 44px rgba(0,0,0,.7); cursor:grab; user-select:none;
  font:12px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace;
  transform:translate(-50%,180%); transition:transform .34s cubic-bezier(.22,1,.36,1);
`;

const row = document.createElement('div');
row.style.cssText = 'display:flex; gap:7px; align-items:stretch;';
hs.appendChild(row);

const CREDIT = 'Made By Blurski';
const INVITE = 'https://discord.gg/dMvWJ3BZ9G';

// status line: shows the credit by default, flashes messages, then goes back to the credit
const status = document.createElement('div');
status.style.cssText = 'margin-top:9px; font-size:10px; color:#6b7280; height:12px; text-align:center;';
status.textContent = CREDIT;
hs.appendChild(status);
let statusTimer;
const say = (msg, ms = 3000) => {
  status.textContent = msg;
  clearTimeout(statusTimer);
  statusTimer = setTimeout(() => { status.textContent = CREDIT; }, ms);
};

// invite pill: click to copy
const copyText = async txt => {
  try { await navigator.clipboard.writeText(txt); return true; } catch (e) {}
  try {
    const ta = document.createElement('textarea');
    ta.value = txt;
    ta.style.cssText = 'position:fixed; opacity:0; left:-9999px; top:0;';
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand('copy');
    ta.remove();
    return ok;
  } catch (e) { return false; }
};

const pill = document.createElement('button');
pill.textContent = INVITE;
pill.title = 'Click to copy';
pill.style.cssText = `
  display:block; width:100%; height:22px; margin-top:7px; padding:0 10px;
  border-radius:999px; background:#1e212b; border:1px solid #2b2e38; color:#9aa3b5;
  font:inherit; font-size:10px; text-align:center; cursor:pointer; transition:background .12s, color .12s;
`;
pill.onmouseenter = () => pill.style.background = '#262a36';
pill.onmouseleave = () => pill.style.background = '#1e212b';
let pillTimer;
pill.onclick = async ev => {
  ev.stopPropagation();
  const ok = await copyText(INVITE);
  pill.textContent = ok ? 'Copied!' : 'Copy failed';
  pill.style.color = ok ? '#3bd1b4' : '#e0575f';
  clearTimeout(pillTimer);
  pillTimer = setTimeout(() => { pill.textContent = INVITE; pill.style.color = '#9aa3b5'; }, 1400);
};
hs.appendChild(pill);

const btns = H.map(h => {
  const b = document.createElement('button');
  b.style.cssText = `
    flex:1; padding:8px 4px 7px; border-radius:9px; cursor:pointer; font:inherit; font-size:11px;
    background:#1e212b; border:1px solid ${h.c}55; color:${h.c}; transition:background .12s;
    display:flex; flex-direction:column; align-items:center; gap:5px;
  `;
  const label = document.createElement('span');
  label.textContent = h.n;

  let icon;
  if (h.img) {
    icon = document.createElement('img');
    icon.src = h.img;
    icon.alt = h.n;
    icon.draggable = false;
    icon.style.cssText = 'width:22px; height:22px; display:block; pointer-events:none; object-fit:contain;';
  } else {
    const ic = document.createElement('span');
    ic.innerHTML = h.s;
    icon = ic.firstChild;
    icon.style.cssText = 'width:22px; height:22px; display:block; pointer-events:none;';
  }
  b.appendChild(label);
  b.appendChild(icon);

  b.onmouseenter = () => b.style.background = '#262a36';
  b.onmouseleave = () => { if (!b.dataset.on) b.style.background = '#1e212b'; };
  b.onclick = async ev => {
    ev.stopPropagation();
    const t = findToken();
    if (!t) { say('no session token found'); return; }
    say('setting...', 10000);
    try {
      const r = await fetch('https://discord.com/api/v9/hypesquad/online', {
        method: 'POST',
        headers: { Authorization: t, 'Content-Type': 'application/json' },
        body: JSON.stringify({ house_id: h.id })
      });
      if (r.status === 204) {
        btns.forEach((x, i) => {
          const on = i === H.indexOf(h);
          if (on) x.dataset.on = '1'; else delete x.dataset.on;
          x.style.background = on ? H[i].c : '#1e212b';
          x.style.borderColor = on ? H[i].c : H[i].c + '55';
          x.style.color = on ? '#0d0e12' : H[i].c;
          x.style.fontWeight = on ? '700' : '400';
        });
        say(h.n + ' set');
      } else if (r.status === 401) {
        say('token rejected');
      } else if (r.status === 429) {
        const j = await r.json().catch(() => ({}));
        say('rate limited, wait ' + Math.ceil(j.retry_after || 1) + 's');
      } else {
        const j = await r.json().catch(() => ({}));
        say(j.message || 'failed ' + r.status);
      }
    } catch (e) { say(e.message); }
  };
  row.appendChild(b);
  return b;
});

const x = document.createElement('button');
x.textContent = '×';
x.style.cssText = `
  width:24px; border-radius:9px; cursor:pointer; flex:none;
  background:#1e212b; border:1px solid #333744; color:#8b93a3; font:inherit;
`;
x.onclick = () => {
  hs.style.transform = 'translate(-50%,180%)';
  setTimeout(() => { hs.remove(); window.__hs = null; }, 340);
};
row.appendChild(x);

let d = null;
hs.addEventListener('pointerdown', e => {
  if (e.target.tagName === 'BUTTON') return;
  const r = hs.getBoundingClientRect();
  d = { x: e.clientX, y: e.clientY, l: r.left, t: r.top };
  hs.style.transition = 'none';
  hs.style.left = r.left + 'px';
  hs.style.top = r.top + 'px';
  hs.style.bottom = 'auto';
  hs.style.transform = 'none';
  hs.setPointerCapture(e.pointerId);
});
hs.addEventListener('pointermove', e => {
  if (!d) return;
  hs.style.left = Math.max(0, Math.min(innerWidth - hs.offsetWidth, d.l + e.clientX - d.x)) + 'px';
  hs.style.top = Math.max(0, Math.min(innerHeight - hs.offsetHeight, d.t + e.clientY - d.y)) + 'px';
});
hs.addEventListener('pointerup', () => { d = null; });

window.__hs = hs;
document.body.appendChild(hs);
requestAnimationFrame(() => requestAnimationFrame(() => hs.style.transform = 'translate(-50%,0)'));
})();
